<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MindMapCanvas</RootNamespace>
    <AssemblyName>MindMapCanvas</AssemblyName>
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
    <Version>1.8.3</Version>
    <AssemblyTitle>MindMap Canvas</AssemblyTitle>
    <Product>MindMap Canvas</Product>
    <ApplicationManifest></ApplicationManifest>
    <!-- Allows compiling on non-Windows build hosts; app still runs on Windows only. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- No single-file compression: it forces a full in-memory decompress on every
         launch (multi-second startup hang). ReadyToRun precompiles IL for fast startup;
         the MSI's own compression keeps the download small. -->
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <PackageReference Include="Emoji.Wpf" Version="0.3.4" />
  </ItemGroup>

</Project>
