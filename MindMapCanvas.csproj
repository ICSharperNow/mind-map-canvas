<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MindMapCanvas</RootNamespace>
    <AssemblyName>MindMapCanvas</AssemblyName>
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
    <Version>1.0.1</Version>
    <AssemblyTitle>MindMap Canvas</AssemblyTitle>
    <Product>MindMap Canvas</Product>
    <ApplicationManifest></ApplicationManifest>
    <!-- Allows compiling on non-Windows build hosts; app still runs on Windows only. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

</Project>
