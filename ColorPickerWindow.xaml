<Window x:Class="MindMapCanvas.ColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Custom color"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        SizeToContent="WidthAndHeight" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" ResizeMode="NoResize"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        MouseLeftButtonDown="Window_Drag" KeyDown="Window_KeyDown">
    <Border CornerRadius="14" BorderThickness="1" Margin="20"
            Background="{DynamicResource Brush.PanelBg}"
            BorderBrush="{DynamicResource Brush.PanelBorder}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="4" Opacity="0.32"/>
        </Border.Effect>
        <StackPanel Margin="22,18,22,18">
            <TextBlock Text="Custom color" FontSize="15" FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.Text}" Margin="0,0,0,12"/>

            <StackPanel Orientation="Horizontal">
                <!-- Saturation / value area -->
                <Grid x:Name="SvBox" Width="208" Height="170" Cursor="Cross"
                      MouseLeftButtonDown="Sv_Down" MouseMove="Sv_Move" MouseLeftButtonUp="Sv_Up">
                    <Border CornerRadius="8">
                        <Border.Background>
                            <SolidColorBrush x:Name="HueBase" Color="Red"/>
                        </Border.Background>
                    </Border>
                    <Border CornerRadius="8">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="White" Offset="0"/>
                                <GradientStop Color="#00FFFFFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Border CornerRadius="8">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#00000000" Offset="0"/>
                                <GradientStop Color="Black" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Canvas>
                        <Ellipse x:Name="SvThumb" Width="14" Height="14"
                                 Stroke="White" StrokeThickness="2" Fill="Transparent">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="4" ShadowDepth="0" Opacity="0.6"/>
                            </Ellipse.Effect>
                        </Ellipse>
                    </Canvas>
                </Grid>

                <!-- Hue strip -->
                <Grid x:Name="HueBox" Width="22" Height="170" Margin="14,0,0,0" Cursor="Cross"
                      MouseLeftButtonDown="Hue_Down" MouseMove="Hue_Move" MouseLeftButtonUp="Hue_Up">
                    <Border CornerRadius="8">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#FF0000" Offset="0"/>
                                <GradientStop Color="#FFFF00" Offset="0.17"/>
                                <GradientStop Color="#00FF00" Offset="0.33"/>
                                <GradientStop Color="#00FFFF" Offset="0.5"/>
                                <GradientStop Color="#0000FF" Offset="0.67"/>
                                <GradientStop Color="#FF00FF" Offset="0.83"/>
                                <GradientStop Color="#FF0000" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Canvas>
                        <Border x:Name="HueThumb" Width="22" Height="6" CornerRadius="3"
                                Background="Transparent" BorderBrush="White" BorderThickness="2">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="3" ShadowDepth="0" Opacity="0.6"/>
                            </Border.Effect>
                        </Border>
                    </Canvas>
                </Grid>
            </StackPanel>

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="PreviewSwatch" Width="30" Height="30" CornerRadius="8"
                        BorderBrush="{DynamicResource Brush.PanelBorder}" BorderThickness="1"/>
                <TextBox x:Name="HexBox" Grid.Column="1" Margin="10,0,0,0"
                         Style="{StaticResource ThemedText}" VerticalAlignment="Center"
                         TextChanged="Hex_Changed"/>
            </Grid>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Cancel" Style="{StaticResource DlgSecondary}" MinWidth="84" Click="Cancel_Click"/>
                <Button Content="Apply" Style="{StaticResource DlgPrimary}" MinWidth="84" Margin="8,0,0,0" Click="Ok_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
