<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
    <Package Name="MindMap Canvas"
             Manufacturer="ICSharperNow"
             Version="1.0.4"
             UpgradeCode="80298A68-2B8E-4179-B2BD-FC0B5BEA32B8"
             Language="1033"
             Compressed="yes">

        <MajorUpgrade DowngradeErrorMessage="A newer version of MindMap Canvas is already installed."/>
        <MediaTemplate EmbedCab="yes" CompressionLevel="high"/>

        <Icon Id="AppIcon.exe" SourceFile="$(var.AssetsDir)/app.ico"/>
        <Property Id="ARPPRODUCTICON" Value="AppIcon.exe"/>
        <Property Id="ARPHELPLINK" Value="https://github.com/ICSharperNow/mind-map-canvas"/>

        <StandardDirectory Id="ProgramFiles64Folder">
            <Directory Id="INSTALLFOLDER" Name="MindMapCanvas"/>
        </StandardDirectory>
        <StandardDirectory Id="ProgramMenuFolder"/>
        <StandardDirectory Id="DesktopFolder"/>

        <!-- Whole multi-file publish folder; a regular layout starts much faster
             than a single-file bundle (no per-launch bundle overhead). -->
        <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
            <Files Include="$(var.PublishDir)\**"/>
        </ComponentGroup>

        <!-- Non-advertised shortcuts: launch the exe directly (no Windows Installer
             resolution step) and give the Start menu its normal right-click actions. -->
        <Component Id="AppShortcuts" Directory="ProgramMenuFolder">
            <Shortcut Id="StartMenuShortcut"
                      Name="MindMap Canvas"
                      Description="Mind-mapping board with shapes, connectors, and themes"
                      Target="[INSTALLFOLDER]MindMapCanvas.exe"
                      WorkingDirectory="INSTALLFOLDER"
                      Icon="AppIcon.exe"/>
            <Shortcut Id="DesktopShortcut"
                      Directory="DesktopFolder"
                      Name="MindMap Canvas"
                      Target="[INSTALLFOLDER]MindMapCanvas.exe"
                      WorkingDirectory="INSTALLFOLDER"
                      Icon="AppIcon.exe"/>
            <RegistryValue Root="HKCU" Key="Software\ICSharperNow\MindMapCanvas"
                           Name="shortcuts" Type="integer" Value="1" KeyPath="yes"/>
        </Component>

        <Feature Id="Main" Title="MindMap Canvas" Level="1">
            <ComponentGroupRef Id="AppFiles"/>
            <ComponentRef Id="AppShortcuts"/>
        </Feature>
    </Package>
</Wix>
