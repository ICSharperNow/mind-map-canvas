<Window x:Class="MindMapCanvas.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Brush.WindowBg}">
    <StackPanel Margin="18">
        <TextBlock Text="Theme" FontSize="15" FontWeight="SemiBold"
                   Foreground="{DynamicResource Brush.Text}" Margin="0,0,0,10"/>
        <StackPanel x:Name="ThemeList"/>
        <TextBlock Text="Sticky-note colors are set per note and are not changed by the theme."
                   FontSize="12" Foreground="{DynamicResource Brush.SubtleText}"
                   TextWrapping="Wrap" Margin="0,12,0,0"/>
        <Button Content="Close" Width="84" HorizontalAlignment="Right" Margin="0,16,0,0"
                Style="{StaticResource ToolBtn}"
                BorderBrush="{DynamicResource Brush.PanelBorder}"
                Click="Close_Click"/>
    </StackPanel>
</Window>
